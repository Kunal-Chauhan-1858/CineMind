# CineMind Environment Configuration
APP_NAME="CineMind"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
# Local-dev placeholder only. The app refuses to start with it unless ENVIRONMENT is development/test.
SECRET_KEY="cinemind-super-secret-jwt-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320 # 3 days

# Admin account (admin@cinemind.app). No default: leave empty for no admin account.
ADMIN_PASSWORD=""

# Database
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/cinemind_db
# For SQLite (default zero-config fallback):
DATABASE_URL="sqlite:///./cinemind.db"

# External APIs
TMDB_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
